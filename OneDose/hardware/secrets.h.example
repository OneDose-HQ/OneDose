// File: hardware/secrets.h.example
// Copy this file to hardware/secrets.h and fill in the values. secrets.h is in .gitignore and must never be committed.
#pragma once

#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Address of the laptop running uvicorn, reachable from the ESP32 (same Wi-Fi). No trailing slash.
// Start the API with:  uvicorn main:app --host 0.0.0.0 --port 8000
#define BACKEND_URL   "http://192.168.1.50:8000"

// Must equal DEVICE_KEY in backend/.env
#define DEVICE_KEY    "same-value-as-DEVICE_KEY-in-.env"

// Must equal a row in the devices table:  INSERT INTO devices(name) VALUES ('ward-1-reader');
#define DEVICE_NAME   "ward-1-reader"

// Must equal CARD_SALT in backend/.env (default below) and the salt used in 06_seed_synthetic.sql
#define CARD_SALT     "OneDoseDemoCardSalt2026"
