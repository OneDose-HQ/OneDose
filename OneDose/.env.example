# Copy to .env and fill in. Never commit .env.
# Run the API from the backend folder; the .env in this folder (or any parent) is found automatically.

# --- PostgreSQL. The API connects as the limited login role 'onedose_api' created by dbms/08_security.sql.
# After running 08, set its password once (as a superuser):  ALTER ROLE onedose_api PASSWORD 'choose-a-strong-one';
DB_HOST=localhost
DB_PORT=5432
DB_NAME=onedose
DB_USER=onedose_api
DB_PASSWORD=
# 'prefer' is fine on your own machine. Use 'require' for a hosted database such as Neon.
DB_SSLMODE=prefer

# --- Secrets: use long random values (32+ characters), different on every machine.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Must equal DEVICE_KEY in hardware/secrets.h (the ESP32 card reader sends it in the X-Device-Key header)
DEVICE_KEY=

# --- Card hashing. Must equal CARD_SALT in hardware/secrets.h and the salt used when the cards were seeded.
# This default is the public DEMO salt from the seed data. Use your own salt for any real deployment.
CARD_SALT=OneDoseDemoCardSalt2026

# --- Gemini (optional). Without a key every alert explanation uses the fixed template.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- The address the dashboard is served from (CORS)
ALLOWED_ORIGIN=http://localhost:5173
